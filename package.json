{
  "name": "bc-truck-works-live-companion",
  "version": "1.0.1.
  "private": true,
  "description": "BC Truck Works Live Companion for ATS and ETS2",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node index.js",
    "start: production": "node index.js",
    "lint": "eslint .",
    "desktop: start": "electron .",
    "desktop:dist": "npm install --include=dev && npm run build && electron-builder --win nsis",
    "simulate: convoy": "node scripts/simulate-convoy.mjs",
    "bot: start": "node bot/index.js"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "styled-jsx": "^5.1.6",
    "@vercel/analytics": "^1.5.0",
    "trucksim-telemetry": "^1.0.0",
    "discord.js": "^14.19.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.bctruckworks.livecompanion",
    "productName": "BC Truck Works Live Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "BC-Truck-Works-Companion-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BC Truck Works Live Companion",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/telemetry-bridge.cjs",
        "to": "telemetry/telemetry-bridge.cjs"
      },
      {
        "from": "node_modules/trucksim-telemetry",
        "to": "telemetry/node_modules/trucksim-telemetry",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "dospatch",
        "repo": "bc-truck-works-live-companion",
        "releaseType": "release"
      }
    ]
  }
}
