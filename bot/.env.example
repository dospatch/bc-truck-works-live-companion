# BC Truck Works Discord bot environment template
# Configure these in your hosting provider's Environment Variables.
# Never commit a real Discord token or other secrets to GitHub.

# Required: Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# Optional Discord server and channel routing
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_CHANGELOG_CHANNEL_ID=
DISCORD_RELEASE_ROLE_ID=
DISCORD_SUGGESTION_CHANNEL_ID=
DISCORD_ISSUE_CHANNEL_ID=
DISCORD_TICKET_STAFF_ROLE_ID=
DISCORD_TICKET_CATEGORY_ID=

# GitHub repository in owner/repository format
GITHUB_REPOSITORY=dospatch/bc-truck-works-live-companion

# Release polling interval in seconds (minimum 30)
RELEASE_POLL_SECONDS=60
