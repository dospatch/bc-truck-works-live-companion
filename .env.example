# Optional persistent convoy storage (recommended for hosted multi-driver use)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional simulator target. Defaults to http://localhost:3000
# CONVOY_BASE_URL=http://localhost:3000

# Optional hosting settings
# PORT=3000
# SERVER_PORT=3000
# HOSTNAME=0.0.0.0
# NODE_ENV=development

# Discord webhook for community idea submissions. Keep this secret; never commit the actual URL.
# DISCORD_IDEAS_WEBHOOK_URL=
